{
	"name": "githandler",
	"productName": "GitHandler",
	"version": "0.12.0",
	"description": "Client Git desktop Linux-first: grafo della storia, diff, staging e commit",
	"main": "dist/main/index.js",
	"private": true,
	"license": "GPL-3.0-or-later",
	"author": "emaxlele",
	"scripts": {
		"build": "node esbuild.mjs",
		"start": "npm run build && electron .",
		"dev": "node esbuild.mjs --watch",
		"test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mts",
		"typecheck": "tsc --noEmit",
		"shots": "bash build/shots.sh",
		"bench": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON bench/bench.mts",
		"mcp": "node dist/mcp/index.js",
		"deb": "bash build/package-deb.sh",
		"appimage": "bash build/package-appimage.sh",
		"rpm": "bash build/package-rpm.sh",
		"flatpak": "bash build/package-flatpak.sh"
	},
	"devDependencies": {
		"@types/node": "^24.10.1",
		"electron": "^45.2.3",
		"esbuild": "^0.28.2",
		"typescript": "^5.9.3"
	},
	"allowScripts": {
		"electron@45.2.3": true,
		"esbuild@0.28.2": true
	},
	"dependencies": {
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/language": "^6.13.1",
		"@codemirror/legacy-modes": "^6.5.5",
		"@lezer/highlight": "^1.2.5"
	}
}
